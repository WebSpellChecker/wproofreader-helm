# Versions for scripts/stack-test.sh and scripts/ci/install-tools.sh.
# The k3s image sets the Kubernetes version of the test cluster.
K3S_IMAGE=rancher/k3s:v1.36.5-k3s1
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.36.5
HELM_VERSION=v3.22.0
CRANE_VERSION=v0.22.1

# Release tags of the other charts of the stack, used when no chart directory is given.
MYSQL_CHART_TAG=v1.0.1
ADMIN_PANEL_CHART_TAG=v1.0.0
